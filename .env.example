# Copie para .env (ou configure no painel da hospedagem).

# PostgreSQL externo. Deixe vazio para usar o banco embutido gravado em DATA_DIR.
DATABASE_URL=

# Pasta do banco embutido (ignorada quando DATABASE_URL está definido).
DATA_DIR=./data

PORT=3000
# Duração da sessão, em horas.
SESSION_HOURS=12
